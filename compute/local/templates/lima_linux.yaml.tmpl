# Setting the VM type to qemu targets QEMU with KVM acceleration, the standard
# hypervisor on Linux hosts. Unlike Apple's Virtualization.framework (used in
# the Darwin template), QEMU relies on the host's /dev/kvm device and does not
# require a separate hypervisor daemon; Lima manages the QEMU invocation directly.
vmType: qemu

# The architecture is always one of aarch64 or x86_64; Lima translates these to
# the corresponding QEMU machine type when selecting the image to boot.
arch: {{ .Arch }}

# These values are passed directly to the hypervisor without validation against
# host resources. The Lima documentation recommends conservative overallocation
# (e.g. 4 CPUs and 4GiB memory) to maintain good performance on a wide range of
# host machines.
cpus: {{ .CPUs }}
memory: {{ .Memory }}
disk: {{ .Disk }}

# Lima's image management is very basic: it only supports copying a local file
# into its internal storage directory and does not support downloading from an
# external source or unpacking archives. The image must be prepared in advance
# in the path provided here. Lima also does not validate the image content; if
# the image is incompatible with the host architecture, provisioning will fail.
images:
  - location: {{ .ImagePath }}
    arch: {{ .Arch }}

# Disable Lima's built-in containerd management. The provision script below
# manages containerd, and Lima must not launch a parallel instance.
containerd:
  system: false
  user: false

# 9p is used on Linux because QEMU on a Linux host does not support virtiofs
# without a virtiofsd daemon running on the host side. The Darwin template uses
# virtiofs because Apple's Virtualization.framework has built-in virtiofs
# support and needs no additional host process. virtiofs offers lower latency
# and better POSIX semantics than 9p, but it is not available here without
# introducing an external host-side dependency.
mountType: 9p

# The machine resource directory ships the cruxd binary next to the disk image.
# It is mounted read-only so the provision script can install cruxd from it.
mounts:
  - location: "{{ .MachineDir }}"
    mountPoint: "{{ .GuestMachineDir }}"
    writable: false

# Installs containerd when the base image does not include it, then enables and
# starts it under whichever init system the image uses. This runs inside the VM
# on every boot, before Lima marks the instance as ready.
provision:
  - mode: system
    script: |
      #!/bin/sh
      set -eu
      if ! command -v containerd >/dev/null 2>&1; then
        if command -v apt-get >/dev/null 2>&1; then
          export DEBIAN_FRONTEND=noninteractive
          apt-get update
          apt-get install -y containerd
        elif command -v apk >/dev/null 2>&1; then
          apk add --no-cache containerd
        fi
      fi
      if command -v systemctl >/dev/null 2>&1; then
        systemctl enable --now containerd
      elif command -v rc-service >/dev/null 2>&1; then
        rc-update add containerd default
        rc-service containerd start
      fi

  # Installs cruxd from the mounted machine resource and runs it as a service.
  # The binary is reinstalled and the service restarted on every boot, so the
  # VM always runs the cruxd shipped with its machine resource.
  - mode: system
    script: |
      #!/bin/sh
      set -eu
      install -m 0755 "{{ .CruxdBinary }}" /usr/local/bin/cruxd
      if command -v systemctl >/dev/null 2>&1; then
        cat > /etc/systemd/system/cruxd.service <<'EOF'
      [Unit]
      Description=Crucible machine agent
      After=containerd.service
      Requires=containerd.service

      [Service]
      ExecStart=/usr/local/bin/cruxd
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target
      EOF
        systemctl daemon-reload
        systemctl enable cruxd
        systemctl restart cruxd
      elif command -v rc-service >/dev/null 2>&1; then
        cat > /etc/init.d/cruxd <<'EOF'
      #!/sbin/openrc-run
      description="Crucible machine agent"
      command="/usr/local/bin/cruxd"
      command_background=true
      pidfile="/run/cruxd.pid"
      depend() {
        need containerd
      }
      EOF
        chmod 0755 /etc/init.d/cruxd
        rc-update add cruxd default
        rc-service cruxd restart
      fi

# Lima polls these after provisioning and marks the instance ready only once
# all probes pass. cruxd's health check also covers containerd.
probes:
  - mode: readiness
    description: cruxd to be running
    script: |
      #!/bin/sh
      wget -q -O /dev/null "http://127.0.0.1:{{ .CruxdPort }}{{ .CruxdHealthPath }}"
    hint: cruxd is not running

# Forward cruxd's port to the same port on the host loopback interface. crux
# talks to the machine only through cruxd.
portForwards:
  - guestPort: {{ .CruxdPort }}
    hostIP: "127.0.0.1"
    hostPort: {{ .CruxdPort }}
