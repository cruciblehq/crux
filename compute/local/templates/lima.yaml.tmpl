vmType: vz
arch: {{ .Arch }}
cpus: {{ .CPUs }}
memory: {{ .Memory }}
disk: {{ .Disk }}
images:
  - location: {{ .ImagePath }}
    arch: {{ .Arch }}
# The machine image must include containerd and all required services
# pre-configured.
containerd:
  system: false
  user: false
mountType: virtiofs
mounts:
  - location: {{ .Home }}
    writable: true
provision:
  # Reconfigure containerd so its Unix socket is owned by the Lima user.
  # The Lima SSH ControlMaster is established before cloud-init provision
  # runs, so supplementary group membership cannot be relied upon for socket
  # access. Setting uid in the [grpc] config makes containerd create the
  # socket owned by the Lima user; the SSH stream-local forward can then
  # connect as the socket owner regardless of groups.
  #
  # This script runs on every boot (per-boot Lima provision). Strategy:
  #
  #  1. Write config.toml atomically before containerd can read it.
  #  2. Write rc_after="tiny-cloud-main" to /etc/conf.d/containerd so that
  #     OpenRC starts containerd only after tiny-cloud-main (this script)
  #     has completed on every subsequent boot. This is the official OpenRC
  #     mechanism for adding ordering constraints from outside the init.d
  #     script and does not depend on the exact content of the init.d file.
  #  3. First-boot safety net: the rc_after constraint takes effect from the
  #     next boot. On the very first boot containerd may have started
  #     concurrently using a stale or absent config. If the socket exists
  #     but is owned by root, restart containerd so it re-reads the new
  #     config and recreates the socket with the correct uid. With
  #     supervisor=supervise-daemon the restart is asynchronous; Lima's
  #     readiness probe polls until the new socket appears.
  - mode: system
    script: |
      #!/bin/sh
      # Create containerd group (idempotent) and derive its GID.
      addgroup containerd 2>/dev/null || true
      CONTAINERD_GID=$(grep '^containerd:' /etc/group | cut -d: -f3)
      CONTAINERD_GID="${CONTAINERD_GID:-1000}"
      # Lima user UID baked in at template-render time on the host so no
      # guest id(1) lookup is needed (the user may not exist yet in the
      # guest /etc/passwd when this script first runs).
      LIMA_UID={{ .UserUID }}
      # Write containerd config atomically. Using a temp file in the same
      # directory as the destination keeps the rename on one filesystem so
      # mv(1) is an atomic rename. printf per-line avoids heredoc indentation
      # issues inside YAML.
      mkdir -p /etc/containerd
      TMPFILE=$(mktemp /etc/containerd/config.toml.XXXXXX)
      {
        printf 'version = 2\n\n'
        printf '[grpc]\n'
        printf '  address = "/run/containerd/containerd.sock"\n'
        printf '  uid = %s\n' "${LIMA_UID}"
        printf '  gid = %s\n\n' "${CONTAINERD_GID}"
        printf '[plugins."io.containerd.grpc.v1.cri"]\n'
        printf '  sandbox_image = "registry.k8s.io/pause:3.10"\n'
      } > "${TMPFILE}"
      mv "${TMPFILE}" /etc/containerd/config.toml
      # Ensure the socket directory is traversable by the Lima user. With
      # mode 0711 others can traverse to the socket path; connect() only
      # requires the socket to be writable by the caller (which it is, since
      # the socket will be owned by LIMA_UID with mode 0660).
      mkdir -p /run/containerd
      chmod 711 /run/containerd
      # Guarantee ordering from the next boot onward: OpenRC reads
      # /etc/conf.d/SERVICE at each runlevel transition and applies rc_after
      # as an extra ordering constraint without modifying the init.d script.
      if ! grep -q 'tiny-cloud-main' /etc/conf.d/containerd 2>/dev/null; then
        printf 'rc_after="tiny-cloud-main"\n' >> /etc/conf.d/containerd
      fi
      # First-boot safety net: if containerd won the concurrent-start race
      # and the socket is owned by root rather than LIMA_UID, restart it so
      # it picks up the new config.toml. The Lima readiness probe polls until
      # the new socket appears.
      if test -S /run/containerd/containerd.sock; then
        SOCK_UID=$(stat -c '%u' /run/containerd/containerd.sock 2>/dev/null || echo 0)
        if [ "${SOCK_UID}" != "${LIMA_UID}" ]; then
          rc-service containerd restart >/dev/null 2>&1 || true
        fi
      fi
probes:
  - mode: readiness
    description: containerd to be running
    script: |
      #!/bin/sh
      test -S /run/containerd/containerd.sock
    hint: containerd is not running
# Forward the containerd Unix socket from the guest to the host. Unix domain
# sockets on virtiofs are visible on both sides but the kernel socket state
# does not cross the boundary. Lima tunnels the connection over SSH so the
# host can dial its local path transparently.
portForwards:
  - guestSocket: "{{ .GuestSocket }}"
    hostSocket: "{{ .HostSocket }}"
